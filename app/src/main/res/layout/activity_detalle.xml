<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="16dp"
    android:layout_marginRight="16dp"
    android:layout_marginTop="10dp"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#3D4BA0">

        <!-- Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txt_hero_publisher"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DC COMICS"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:letterSpacing="0.1"/>

        </LinearLayout>

        <!-- Hero Image -->
        <ImageView
            android:id="@+id/img_hero"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:scaleType="centerCrop"
            android:background="#E0E0E0"/>

        <!-- Hero Name -->
        <TextView
            android:id="@+id/txt_hero_nombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BATMAN"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:padding="12dp"
            android:letterSpacing="0.05"/>

        <!-- Real Name -->
        <TextView
            android:id="@+id/txt_hero_nombre_real"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bruce Wayne"
            android:textSize="16sp"
            android:textStyle="italic"
            android:textColor="#BDC3C7"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingBottom="12dp"/>

        <!-- Stats Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="#3D4BA0">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="STATS"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:letterSpacing="0.1"
                android:layout_marginBottom="12dp"/>

            <!-- Intelligence -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="Intelligence"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"/>

                <TextView
                    android:id="@+id/txt_hero_intelligence"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="100"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#3498DB"
                    android:gravity="end"/>
            </LinearLayout>

            <!-- Strength -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="Strength"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"/>

                <TextView
                    android:id="@+id/txt_hero_strength"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="26"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#E74C3C"
                    android:gravity="end"/>
            </LinearLayout>

            <!-- Speed -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="Speed"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"/>

                <TextView
                    android:id="@+id/txt_hero_speed"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="27"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#F39C12"
                    android:gravity="end"/>
            </LinearLayout>

            <!-- Power -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="Power"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"/>

                <TextView
                    android:id="@+id/txt_hero_power"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="47"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#9B59B6"
                    android:gravity="end"/>
            </LinearLayout>

            <!-- Combat -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="Combat"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"/>

                <TextView
                    android:id="@+id/txt_hero_combat"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="100"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#2ECC71"
                    android:gravity="end"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>