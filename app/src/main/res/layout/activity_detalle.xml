<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_hero2">


<androidx.cardview.widget.CardView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="15dp"
    android:layout_marginRight="15dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="5dp"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/black">

        <!-- Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:fontFamily="@font/roboto"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:id="@+id/txt_hero_publisher"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="DC COMICS"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Hero Image -->
        <ImageView
            android:id="@+id/img_hero"
            android:layout_width="match_parent"
            android:layout_height="290dp"
            android:scaleType="centerCrop"
            android:background="#E0E0E0"/>

        <!-- Hero Name -->
        <TextView
            android:id="@+id/txt_hero_nombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BATMAN"
            android:textSize="28sp"
            android:fontFamily="@font/roboto_bold"
            android:textColor="#FFFFFF"
            android:padding="12dp"
            android:letterSpacing="0.05"/>

        <!-- Real Name -->
        <TextView
            android:id="@+id/txt_hero_nombre_real"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_condensed_bold_italic"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingBottom="12dp"
            android:text="Bruce Wayne"
            android:textColor="#BDC3C7"
            android:textSize="16sp"
            android:textStyle="italic" />

        <!-- Stats Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:backgroundTint="@color/gray"
            android:padding="12dp"
            android:background="#3D4BA0">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="STATS"
                android:textSize="14sp"
                android:fontFamily="@font/roboto"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:letterSpacing="0.1"
                android:layout_marginBottom="12dp"/>

            <!-- Intelligence -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="Intelligence"
                    android:textSize="13sp"
                    android:fontFamily="@font/roboto"
                    android:textColor="#FFFFFF"/>

                <TextView
                    android:id="@+id/txt_hero_intelligence"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="100"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/roboto"
                    android:textColor="#3498DB"
                    android:gravity="end"/>
            </LinearLayout>

            <!-- Strength -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="Strength"
                    android:fontFamily="@font/roboto"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"/>

                <TextView
                    android:id="@+id/txt_hero_strength"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="26"
                    android:fontFamily="@font/roboto"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/red"
                    android:gravity="end"/>
            </LinearLayout>

            <!-- Speed -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="Speed"
                    android:fontFamily="@font/roboto"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"/>

                <TextView
                    android:id="@+id/txt_hero_speed"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="27"
                    android:textSize="16sp"
                    android:fontFamily="@font/roboto"
                    android:textStyle="bold"
                    android:textColor="#F39C12"
                    android:gravity="end"/>
            </LinearLayout>

            <!-- Power -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto"
                    android:text="Power"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"/>

                <TextView
                    android:id="@+id/txt_hero_power"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="47"
                    android:textSize="16sp"
                    android:fontFamily="@font/roboto"
                    android:textStyle="bold"
                    android:textColor="#9B59B6"
                    android:gravity="end"/>
            </LinearLayout>

            <!-- Combat -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="Combat"
                    android:fontFamily="@font/roboto"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"/>


                <TextView
                    android:id="@+id/txt_hero_combat"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="100"
                    android:fontFamily="@font/roboto"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#2ECC71"
                    android:gravity="end"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>

