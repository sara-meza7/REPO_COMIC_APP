<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_registro">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/input_field_back"
        android:gravity="center"
        android:padding="16dp">

        <ImageView
            android:id="@+id/imgHeroDetail"
            android:layout_width="250dp"
            android:layout_height="300dp"
            android:scaleType="centerCrop"
            android:layout_marginTop="20dp" />

        <TextView
            android:id="@+id/txtHeroDetailName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hero Name"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#F0E4D5"
            android:layout_marginTop="20dp" />

        <TextView
            android:id="@+id/txtFullName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Full Name: "
            android:textSize="18sp"
            android:textColor="#F0E4D5"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/txtIntelligence"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Intelligence: "
            android:textSize="16sp"
            android:textColor="#F0E4D5"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/txtStrength"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Strength: "
            android:textSize="16sp"
            android:textColor="#F0E4D5"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/txtSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Speed: "
            android:textSize="16sp"
            android:textColor="#F0E4D5"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/txtPower"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Power: "
            android:textSize="16sp"
            android:textColor="#F0E4D5"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>